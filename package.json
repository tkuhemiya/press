{
  "name": "press",
  "version": "0.3.0",
  "description": "A Markdown-like language for explanations that mix prose and diagrams.",
  "license": "MIT",
  "bin": {
    "press": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "build:examples": "node src/cli.ts build docs/examples/*.md --out-dir docs/examples/out",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "oxfmt --check && oxlint && tsc && knip",
    "test": "vitest run"
  },
  "dependencies": {
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "knip": "^6.43.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26"
  }
}
