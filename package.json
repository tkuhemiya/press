{
  "name": "press",
  "version": "0.3.0",
  "description": "A Markdown-like language for explanations that mix prose and diagrams.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "press": "./src/cli.ts"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build:examples": "node src/cli.ts build examples/*.md --out-dir examples/out",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
